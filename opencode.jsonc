{
  // BenchDeck OpenCode Configuration
  // See https://opencode.ai/docs/configuration for schema reference.

  "$schema": "https://opencode.ai/schemas/opencode.json",

  // Global agent defaults
  "agent": {
    "default": {
      "model": "gpt-4o-mini",
      "temperature": 0.1,
      "maxSteps": 40
    }
  },

  // Custom tool definitions in .opencode/tools/*.ts
  "tools": {
    "benchdeck_live_run": {
      "source": ".opencode/tools/benchdeck_live_run.ts",
      "description": "Run a real BenchDeck OpenAI benchmark in a dedicated ephemeral container"
    },
    "evidence_record": {
      "source": ".opencode/tools/evidence.ts",
      "export": "record",
      "description": "Append one structured product-test result to the active evidence package"
    },
    "evidence_write_report": {
      "source": ".opencode/tools/evidence.ts",
      "export": "write_report",
      "description": "Write the final evidence-backed Markdown report"
    },
    "repository_state": {
      "source": ".opencode/tools/repository.ts",
      "description": "Read fixed Git repository identity and dirty-state metadata"
    },
    "sandbox_create": {
      "source": ".opencode/tools/sandbox.ts",
      "export": "create",
      "description": "Create an isolated rootless-Docker BenchDeck test sandbox"
    },
    "sandbox_destroy": {
      "source": ".opencode/tools/sandbox.ts",
      "export": "destroy",
      "description": "Destroy active product-test containers and network"
    },
    "sandbox_exec": {
      "source": ".opencode/tools/sandbox.ts",
      "export": "exec",
      "description": "Execute a command inside the active sandbox"
    },
    "sandbox_exec_with_output": {
      "source": ".opencode/tools/sandbox.ts",
      "export": "exec_with_output",
      "description": "Execute a command and retrieve matching output files"
    },
    "sandbox_export_patch": {
      "source": ".opencode/tools/sandbox.ts",
      "export": "export_patch",
      "description": "Export candidate sandbox changes as a Git patch"
    },
    "sandbox_pty": {
      "source": ".opencode/tools/sandbox_pty.ts",
      "description": "Run a command under a PTY inside the sandbox"
    },
    "sandbox_status": {
      "source": ".opencode/tools/sandbox.ts",
      "export": "status",
      "description": "Return active sandbox identity and container state"
    }
  },

  // Custom agent registrations
  // Permissions, steps, temperature, and mode are defined per-agent in .opencode/agents/*.md
  "agents": {
    "benchdeck-product-tester": {
      "source": ".opencode/agents/benchdeck-product-tester.md",
      "description": "Orchestrates complete evidence-backed live product testing"
    },
    "benchdeck-test-cli": {
      "source": ".opencode/agents/benchdeck-test-cli.md",
      "description": "Black-box testing of every BenchDeck CLI command"
    },
    "benchdeck-test-discovery": {
      "source": ".opencode/agents/benchdeck-test-discovery.md",
      "description": "Inventories every BenchDeck product feature"
    },
    "benchdeck-test-live-api": {
      "source": ".opencode/agents/benchdeck-test-live-api.md",
      "description": "Validates BenchDeck against the real OpenAI API"
    },
    "benchdeck-test-performance": {
      "source": ".opencode/agents/benchdeck-test-performance.md",
      "description": "Measures BenchDeck startup, loading, and rendering performance"
    },
    "benchdeck-test-regression": {
      "source": ".opencode/agents/benchdeck-test-regression.md",
      "description": "Runs lint, format, typing, unit, and integration regression checks"
    },
    "benchdeck-test-reporter": {
      "source": ".opencode/agents/benchdeck-test-reporter.md",
      "description": "Converts product-test evidence into traceability matrix and report"
    },
    "benchdeck-test-security": {
      "source": ".opencode/agents/benchdeck-test-security.md",
      "description": "Tests trust boundaries, secret handling, and archive safety"
    },
    "benchdeck-test-tui": {
      "source": ".opencode/agents/benchdeck-test-tui.md",
      "description": "Drives the curses TUI through a PTY and verifies behavior"
    },
    "benchdeck-test-verifier": {
      "source": ".opencode/agents/benchdeck-test-verifier.md",
      "description": "Independently reproduces material test findings"
    },
    "benchdeck-test-webui": {
      "source": ".opencode/agents/benchdeck-test-webui.md",
      "description": "Tests browser interface only if one exists"
    },
    "repo-auditor": {
      "source": ".opencode/agents/repo-auditor.md",
      "description": "Audits BenchDeck with bounded evidence and writes AGENT_HANDOFF.md"
    },
    "repository-docs": {
      "source": ".opencode/agents/repository-docs.md",
      "description": "Audits and maintains repository documentation"
    },
    "tui-precision-editor": {
      "source": ".opencode/agents/tui-precision-editor.md",
      "description": "Implements bounded curses TUI changes"
    },
    "tui-screenshot": {
      "source": ".opencode/agents/tui-screenshot.md",
      "description": "Generates and validates TUI screenshot candidates"
    }
  }
}
